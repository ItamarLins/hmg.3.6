-inc
-o../../ide/IDE_UNICODE

# Define a aplicação explicitamente como Windows GUI
-gtgui
-gtwin
-gui
-ldflag=-Wl,--subsystem,windows

# Aumentar tamanho da pilha para 32MB (Sem aspas!)
-ldflag=-Wl,--stack,33554432

# Flags do Compilador C (Clang / GCC 64-bits)
-cflag=-m64
-cflag=-Wno-void-pointer-to-int-cast
-cflag=-Wno-pointer-to-int-cast
-cflag=-Wno-unused-variable

# Flags do Linker 64-bits
-ldflag=-m64

-w2
-static
-mt

# Bibliotecas do Windows
-lgdiplus
-lmsimg32
-lwinmm
-lcomctl32
-lcomdlg32
-lole32
-loleaut32
-luuid
-lvfw32

